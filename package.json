{
  "name": "collabify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd frontend && next dev -p 4028",
    "build": "cd frontend && next build",
    "start": "cd frontend && next dev -p 4028",
    "lint": "cd frontend && next lint",
    "lint:fix": "cd frontend && next lint --fix",
    "format": "cd frontend && prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "cd frontend && next start",
    "type-check": "cd frontend && tsc --noEmit"
  }
}
